{
  // =====================================================================
  // Codex Quota Keeper 配置模板（JSONC 格式：支持 // 行注释 与 /* 块注释 */）
  // 本模板使用 .jsonc 扩展名，编辑器会按 JSON with Comments 渲染、不报错；
  // 若复制为 config.json 后保留注释，有的编辑器会按严格 JSON 标红（可删除注释行）。
  //
  // 用法：
  //   1. 把本文件复制为同目录下的 config.json，然后取消注释你要自定义的项。
  //   2. 被注释（未配置）的字段使用代码内置默认值，完整字段表见 README「配置」章节。
  //   3. 单机 MonitorOnly（默认）：无需任何修改，直接 install.cmd。
  //   4. 多机：取消注释下方 github 段的协调/历史两块，先执行
  //      pwsh scripts/setup-log-repo.ps1 -RepoPath <日志仓库路径> 绑定仓库。
  //   5. 改完执行 apply-config.cmd 使计划任务生效（幂等，可反复执行）。
  // =====================================================================
  "schemaVersion": 2,

  // 运行模式：MonitorOnly（默认，只读额度、不调用模型）| AutoAnchor（实验，见下方说明）
  "mode": "MonitorOnly",

  // ---- 定时 / 轮询 ------------------------------------------------------
  "poll": {
    // 额度轮询周期（分钟），即计划任务重复间隔；必须 >= minimumIntervalMinutes（低于 5 会被拒绝）
    // "intervalMinutes": 60,
    // 允许的最小间隔下限（验证用）
    // "minimumIntervalMinutes": 5,
  },

  // ---- 多机协调（Leader 租约）--------------------------------------------
  "leader": {
    // 是否启用租约协调（单机保持默认 true 即为本地 Leader；多机互斥靠下方 github 段）
    // "enabled": true,
    // 本机标签（status / 审计里区分机器用）
    // "label": "Home PC",
    // 租约 TTL（分钟，默认 ≈轮询周期 3 倍）。必须满足校验关系：
    // leaseTtlMinutes >= max(2 * poll.intervalMinutes, poll.intervalMinutes + graceMinutes + 5)，
    // 否则租约会在一轮轮询之间过期、Leader 在两台机器间反复抖动（flapping）。
    // "leaseTtlMinutes": 180,
    // 时钟漂移 / 网络延迟容忍（分钟）
    // "graceMinutes": 5,
    // 租约过期后允许他人接管
    // "takeoverOnExpiry": true,
  },

  // ---- 协调与历史仓库（GitHub，多机才需要）-------------------------------
  "github": {
    // 默认全部关闭：单机无需任何 Git 仓库即可运行（LOCAL_ONLY，多机不安全）。
    // 多机步骤：每台机器执行 pwsh scripts/setup-log-repo.ps1 -RepoPath <路径> 后，
    // 取消注释下面两块并填写你的专用 Private 日志仓库路径。
    "coordination": {
      // 租约协调开关（false = 单机 LOCAL_ONLY）
      // "enabled": true,
      // 专用 Private 日志仓库本地路径（多机必填）
      // "repoPath": "D:/tools/codex-quota-history",
      // 协调分支名
      // "branch": "cqk/coordination",
    },
    "historySync": {
      // 是否把净化后的重要事件同步到远程 history（多机审计用）
      // "enabled": true,
      // 是否 push history 分支（false 只写本地）
      // "push": true,
      // history 分支名
      // "branch": "cqk/history",
      // 只同步重要事件（普通轮询零写入）
      // "eventsOnly": true,
    },
  },

  // ---- 日志 ---------------------------------------------------------------
  "logging": {
    // 本地日志 / history 保留天数（runner 每轮自动清理）
    // "retentionDays": 90,
    // 隐私开关：machineLabel 是否写入 history（false = 更隐私）
    // "includeMachineLabel": false,
  },

  // ---- Codex 与 AutoAnchor -------------------------------------------------
  "codex": {
    // codex 可执行文件；auto = 自动探测（已兼容 exe/ps1/cmd/bat / npm codex.cmd）
    // "command": "auto",
    // 额度查询超时（秒；这是**每次 JSON-RPC 等待**的超时，不是整轮耗时：一次额度尝试
    // 含 2 次等待，配代理再翻倍）。上限 180，低于 5 拒绝；计划任务 ExecutionTimeLimit
    // 由本值等配置推导（CQK-031）
    // "queryTimeoutSeconds": 20,
    // 出入站代理 URL（http(s):// 或 socks5://）；socks 是否被 codex 识别取决于其自身 HTTP 栈；
    // 代理失败自动回退直连再试一次；空 = 直连
    // "proxy": "http://127.0.0.1:7890",
    // ---- AutoAnchor（实验功能，默认关闭；开启需先设 mode=AutoAnchor）--------
    "autoAnchor": {
      // 实验功能开关（官方未背书该用途，有风控解释风险，见 README）
      // "enabled": false,
      // 锚定用最小 Prompt（≤200 字符；禁换行与 shell 元字符，支持中文）
      // "prompt": "Reply exactly OK.",
      // 每日最大执行次数
      // "maxPerDay": 6,
      // 到期锚定的次级安全间隔（分钟）；schedule 和 anchorOnApply 是显式请求，不受此限制。
      // "minimumGapMinutes": 300,
      // 立即触发 CLI：设为 true 后，install.cmd / apply-config.cmd 会请求立即锚定。
      // 每个本地自然日最多实际尝试一次，不等静默期，仍受每日总上限与 fail-closed 约束。
      // "anchorOnApply": false,
      // 5h 作息对齐：「HH:mm」数组（本地时间，24 小时制且必须补零）。安装时注册原生
      // 每日触发器；runner 到点重读额度，primary 已在运行则跳过。迟到超过一个轮询周期也跳过。
      // 与 anchorOnExpiry 可同时启用；同一时间点每天最多一次。
      // "schedule": ["09:30", "21:00"],
      // 到期补空档：只在所列窗口当前不运行（resetsAt 为空或已过期）时调用一次。
      // 可选值 primary（5h）/ secondary（7d）；默认空数组表示不做任何到期锚定。
      // 每次成功读取会把同一个一次性计划任务指向最早 resetsAt + 1 分钟。
      // "anchorOnExpiry": ["secondary"],
      // 锚定执行的模型：传给 codex exec 的 -m 参数（如 "gpt-5-codex"）。
      // 留空（默认）= 不传 -m，沿用你本机 ~/.codex/config.toml 里 Codex CLI 的默认模型。
      // 填写规则：仅字母/数字/点/下划线/连字符，1-100 字符，如 "gpt-5-codex"、"o3"。
      // 例："model": "gpt-5-codex",
      // 锚定执行的思考等级：传给 codex exec 的 -c model_reasoning_effort=<值> 覆盖。
      // 留空（默认）= 不覆盖，沿用 ~/.codex/config.toml 的 model_reasoning_effort 默认值。
      // 填写规则：小写字母开头，仅小写字母/数字/连字符，1-30 字符，如 "low"、"minimal"。
      // 合法模型与档位以本机 CLI 的 config/read、model/list 校验结果为准。
      // 配置无效或暂时无法校验时，在 Claim 和调用之前拒绝；不消耗当日调用次数。
      // 例："reasoningEffort": "low",
    },
  },

  // ---- Windows 计划任务 ----------------------------------------------------
  "task": {
    // 计划任务名
    // "name": "CodexQuotaKeeper.Check",
    // 开机自启
    // "startWithWindows": true,
    // 仅在有网络时运行
    // "runIfNetworkAvailable": true,
    // 是否允许唤醒计算机执行
    // 仅能从睡眠/休眠唤醒，不能从关机唤醒；笔记本合盖场景建议保持 false。
    // "wakeToRun": false,
    // 到期闹钟任务名；空值自动使用 "<task.name>.AnchorAlarm"
    // "alarmName": "",
  },
}
