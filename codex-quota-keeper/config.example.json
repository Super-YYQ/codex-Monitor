{
  "schemaVersion": 2,
  "mode": "MonitorOnly",
  "poll": {
    "intervalMinutes": 15,
    "minimumIntervalMinutes": 5
  },
  "leader": {
    "enabled": true,
    "leaseTtlMinutes": 45,
    "graceMinutes": 5,
    "takeoverOnExpiry": true,
    "label": "Home PC"
  },
  "github": {
    "coordination": {
      "enabled": true,
      "repoPath": "D:/tools/codex-quota-history",
      "branch": "cqk/coordination"
    },
    "historySync": {
      "enabled": true,
      "push": true,
      "branch": "cqk/history",
      "eventsOnly": true
    }
  },
  "logging": {
    "retentionDays": 90,
    "includeMachineLabel": false
  },
  "codex": {
    "command": "auto",
    "queryTimeoutSeconds": 20,
    "autoAnchor": {
      "enabled": false,
      "prompt": "Reply exactly OK.",
      "maxPerDay": 6,
      "minimumGapMinutes": 60
    }
  },
  "task": {
    "name": "CodexQuotaKeeper.Check",
    "startWithWindows": true,
    "runIfNetworkAvailable": true,
    "wakeToRun": false
  }
}
